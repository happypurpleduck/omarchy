#!/bin/bash

# omarchy:summary=Launch $VISUAL_EDITOR (GUI) or fall back to $EDITOR (terminal)
# omarchy:args=<path>

editor="${VISUAL_EDITOR:-$EDITOR}"
omarchy-cmd-present "$editor" || editor=nvim

case "$editor" in
nvim | vim | nano | micro | hx | helix | fresh)
  exec omarchy-launch-tui "$editor" "$@"
  ;;
*)
  exec setsid uwsm-app -- "$editor" "$@"
  ;;
esac
